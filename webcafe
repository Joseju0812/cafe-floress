<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Café Flores</title>

  <style>
    :root {
      --rojo: #bd0035;
      --rojo-oscuro: #a90030;
      --dorado: #ffb638;
      --texto: #171717;
      --borde: #e9e9e9;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--texto);
      font-family: Arial, Helvetica, sans-serif;
    }

    button, a {
      font: inherit;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      min-height: 66px;
      padding: 10px 3%;
      background: #fff;
      box-shadow: 0 3px 10px #00000014;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--rojo);
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 1.4px;
      white-space: nowrap;
    }

    .brand-mark {
      display: grid;
      width: 30px;
      height: 30px;
      place-items: center;
      border: 2px solid var(--rojo);
      border-radius: 50%;
      font-size: 17px;
    }

    .main-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex: 1;
      gap: 22px;
      font-size: 17px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .main-nav a:first-child,
    .main-nav a:nth-child(3) {
      color: var(--dorado);
    }

    .header-tools {
      display: flex;
      align-items: center;
      gap: 17px;
      font-size: 23px;
    }

    .icon-button,
    .menu-toggle {
      padding: 0;
      border: 0;
      background: none;
      color: var(--texto);
      cursor: pointer;
    }

    .menu-toggle {
      display: none;
      font-size: 25px;
    }

    .section {
      width: min(1500px, 92%);
      margin: 0 auto;
    }

    .favorites {
      padding: 65px 0 52px;
      text-align: center;
    }

    .section-title {
      margin: 0 0 42px;
      color: #080808;
      font-size: clamp(28px, 3vw, 40px);
      font-weight: 800;
      text-align: center;
      text-transform: uppercase;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px;
    }

    .product-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .product-image {
      display: grid;
      width: 100%;
      height: 290px;
      place-items: center;
      overflow: hidden;
    }

    .product-image img {
      width: 82%;
      height: 100%;
      object-fit: contain;
      transition: transform 0.25s ease;
    }

    .product-card:hover .product-image img {
      transform: scale(1.04);
    }

    .product-name {
      min-height: 52px;
      margin: 18px 0 8px;
      font-size: 18px;
      line-height: 1.5;
    }

    .product-price {
      margin: 0 0 18px;
      font-size: 19px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 56px;
      padding: 0 28px;
      border: 0;
      border-radius: 32px;
      background: var(--rojo);
      color: #fff;
      font-weight: 700;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 3px 5px #0003;
      transition: background 0.2s, transform 0.2s;
    }

    .button:hover {
      transform: translateY(-2px);
      background: var(--rojo-oscuro);
    }

    .benefits {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
      padding-bottom: 65px;
    }

    .benefit {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      min-height: 145px;
      padding: 22px;
      border: 2px solid var(--borde);
      border-radius: 14px;
    }

    .benefit-icon {
      color: var(--rojo);
      font-size: 30px;
    }

    .benefit h3 {
      margin: 6px 0 10px;
      font-size: 17px;
      text-transform: uppercase;
    }

    .benefit p {
      margin: 0;
      font-size: 15px;
      line-height: 1.55;
    }

    .menu-section {
      padding: 45px 0 85px;
    }

    .menu-tabs {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin: 0 0 14px;
    }

    .tab-button {
      padding: 13px 17px;
      border: 0;
      background: #fff;
      color: var(--texto);
      font-size: 18px;
      cursor: pointer;
    }

    .tab-button.active {
      background: var(--rojo);
      color: #fff;
    }

    .menu-content {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      gap: 6%;
    }

    .menu-content img {
      display: block;
      width: 100%;
      min-height: 370px;
      max-height: 470px;
      object-fit: cover;
    }

    .menu-copy {
      padding: 25px;
    }

    .menu-copy h3 {
      margin: 0 0 28px;
      color: var(--rojo);
      font-size: 28px;
      text-transform: uppercase;
    }

    .menu-copy p {
      max-width: 600px;
      margin: 0 0 26px;
      font-size: 20px;
      line-height: 1.6;
    }

    .menu-copy .button {
      min-width: 170px;
    }

    .footer {
      padding: 30px 5%;
      background: #f8f8f8;
      color: #555;
      text-align: center;
    }

    .footer strong {
      display: block;
      margin-bottom: 8px;
      color: var(--rojo);
      font-size: 19px;
    }

    .cart-count {
      display: inline-grid;
      width: 19px;
      height: 19px;
      place-items: center;
      border-radius: 50%;
      background: var(--rojo);
      color: white;
      font-size: 12px;
      vertical-align: top;
    }

    @media (max-width: 1050px) {
      .site-header {
        gap: 15px;
      }

      .main-nav {
        gap: 12px;
        font-size: 13px;
      }

      .products,
      .benefits {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {
      .site-header {
        min-height: 60px;
      }

      .menu-toggle {
        display: block;
      }

      .main-nav {
        position: absolute;
        top: 60px;
        right: 0;
        left: 0;
        display: none;
        align-items: stretch;
        padding: 12px 5%;
        background: white;
        box-shadow: 0 5px 8px #00000012;
      }

      .main-nav.open {
        display: flex;
        flex-direction: column;
      }

      .main-nav a {
        padding: 10px 0;
      }

      .header-tools {
        gap: 12px;
      }

      .favorites {
        padding-top: 44px;
      }

      .products {
        gap: 24px 12px;
      }

      .product-image {
        height: 210px;
      }

      .product-name {
        font-size: 15px;
      }

      .button {
        min-height: 48px;
        padding: 0 19px;
        font-size: 12px;
      }

      .benefits {
        gap: 12px;
      }

      .benefit {
        flex-direction: column;
        min-height: 170px;
        gap: 8px;
        padding: 15px;
      }

      .benefit h3 {
        font-size: 14px;
      }

      .benefit p {
        font-size: 13px;
      }

      .menu-content {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .menu-content img {
        min-height: 250px;
      }

      .menu-copy {
        padding: 20px 5px;
      }

      .menu-copy h3 {
        font-size: 23px;
      }

      .menu-copy p {
        font-size: 17px;
      }

      .tab-button {
        padding: 10px;
        font-size: 14px;
      }
    }

    @media (max-width: 420px) {
      .brand {
        font-size: 12px;
        letter-spacing: 0.8px;
      }

      .header-tools {
        font-size: 19px;
      }

      .products,
      .benefits {
        grid-template-columns: 1fr 1fr;
      }

      .product-image {
        height: 165px;
      }
    }
  </style>
</head>

<body>
  <header class="site-header">
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú">☰</button>

    <a class="brand" href="#" aria-label="Café Flores, inicio">
      <span class="brand-mark">☕</span>
      <span>CAFÉ<br>FLORES</span>
    </a>

    <nav class="main-nav" id="mainNav">
      <a href="#">Inicio</a>
      <a href="#legado">Nuestro legado</a>
      <a href="#negocio">Modelos de negocio⌄</a>
      <a href="#menu">Menú</a>
      <a href="#tienda">Mi tienda⌄</a>
      <a href="#sucursales">Sucursales</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <div class="header-tools">
      <button class="icon-button" aria-label="Buscar">⌕</button>
      <button class="icon-button" aria-label="Carrito">
        🛒 <span class="cart-count" id="cartCount">0</span>
      </button>
      <button class="icon-button" aria-label="Mi cuenta">♙</button>
    </div>
  </header>

  <main>
    <section class="section favorites" id="tienda">
      <h1 class="section-title">Nuestros favoritos</h1>

      <div class="products">
        <article class="product-card">
          <div class="product-image">
            <img
              src="https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80"
              alt="Café en grano">
          </div>
          <p class="product-name">Granito’s® Blancos con Chocolate Turin®</p>
          <p class="product-price">$ 179.00</p>
          <button class="button add-to-cart">Añadir al carrito</button>
        </article>

        <article class="product-card">
          <div class="product-image">
            <img
              src="https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=80"
              alt="Concentrado de café">
          </div>
          <p class="product-name">Concentrado de Café</p>
          <p class="product-price">$ 220.00</p>
          <button class="button add-to-cart">Añadir al carrito</button>
        </article>

        <article class="product-card">
          <div class="product-image">
            <img
              src="https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=600&q=80"
              alt="Café Esencia de Amaretto">
          </div>
          <p class="product-name">Café Esencia de Amaretto</p>
          <p class="product-price">$ 490.00</p>
          <button class="button add-to-cart">Añadir al carrito</button>
        </article>

        <article class="product-card">
          <div class="product-image">
            <img
              src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=80"
              alt="Café Esencia de Vainilla">
          </div>
          <p class="product-name">Café Esencia de Vainilla</p>
          <p class="product-price">$ 490.00</p>
          <button class="button add-to-cart">Añadir al carrito</button>
        </article>
      </div>
    </section>

    <section class="section benefits" aria-label="Beneficios de compra">
      <article class="benefit">
        <span class="benefit-icon">▣</span>
        <div>
          <h3>Pagos seguros</h3>
          <p>Contamos con pagos seguros en todas tus compras.</p>
        </div>
      </article>

      <article class="benefit">
        <span class="benefit-icon">▤</span>
        <div>
          <h3>Costo de envío</h3>
          <p>Desde $210 pesos, depende de tu pedido y destino.</p>
        </div>
      </article>

      <article class="benefit">
        <span class="benefit-icon">♧</span>
        <div>
          <h3>Tiempo de envío</h3>
          <p>Entregas en menos de 24 hrs en ZMG. Envío nacional de 3 a 5 días hábiles.</p>
        </div>
      </article>

      <article class="benefit">
        <span class="benefit-icon">◷</span>
        <div>
          <h3>Horarios</h3>
          <p>Adquiere tu café en línea en cualquier momento.</p>
        </div>
      </article>
    </section>

    <section class="section menu-section" id="menu">
      <h2 class="section-title">Nuestro menú</h2>

      <div class="menu-tabs" role="tablist" aria-label="Categorías del menú">
        <button class="tab-button active" data-category="Barra Caliente">Barra Caliente</button>
        <button class="tab-button" data-category="Barra Fría">Barra Fría</button>
        <button class="tab-button" data-category="Alimentos">Alimentos</button>
        <button class="tab-button" data-category="Repostería">Repostería</button>
        <button class="tab-button" data-category="Expendio de Café">Expendio de Café</button>
      </div>

      <div class="menu-content">
        <img
          src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1200&q=85"
          alt="Preparación de una bebida de café">

        <div class="menu-copy">
          <h3 id="menuTitle">Barra caliente</h3>
          <p id="menuDescription">
            Para esos momentos de cálidos apapachos, disfruta de la variedad
            de bebidas calientes que ofrecemos.
          </p>
          <a class="button" href="#contacto">Ver menú</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer" id="contacto">
    <strong>Café Flores</strong>
    <span>Av. Chapultepec 2034</span>
  </footer>

  <script>
    const menuToggle = document.getElementById("menuToggle");
    const mainNav = document.getElementById("mainNav");
    const cartCount = document.getElementById("cartCount");
    const menuTitle = document.getElementById("menuTitle");
    const menuDescription = document.getElementById("menuDescription");

    menuToggle.addEventListener("click", () => {
      mainNav.classList.toggle("open");
    });

    document.querySelectorAll(".add-to-cart").forEach((button) => {
      button.addEventListener("click", () => {
        cartCount.textContent = Number(cartCount.textContent) + 1;
        button.textContent = "Añadido ✓";

        setTimeout(() => {
          button.textContent = "Añadir al carrito";
        }, 1200);
      });
    });

    const descriptions = {
      "Barra Caliente":
        "Para esos momentos de cálidos apapachos, disfruta de la variedad de bebidas calientes que ofrecemos.",
      "Barra Fría":
        "Refréscate con nuestras bebidas frías preparadas al momento con el sabor de nuestro café.",
      "Alimentos":
        "Acompaña tu bebida favorita con opciones deliciosas para cualquier momento del día.",
      "Repostería":
        "Un antojo dulce siempre sabe mejor acompañado de una taza de café.",
      "Expendio de Café":
        "Lleva a casa el sabor de nuestro café y disfruta de una experiencia especial."
    };

    document.querySelectorAll(".tab-button").forEach((tab) => {
      tab.addEventListener("click", () => {
        document.querySelector(".tab-button.active").classList.remove("active");
        tab.classList.add("active");

        const category = tab.dataset.category;
        menuTitle.textContent = category;
        menuDescription.textContent = descriptions[category];
      });
    });
  </script>
</body>
</html>
